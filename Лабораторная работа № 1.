import csv
from io import StringIO
from typing import Optional

def parse_csv(data: str) -> list[dict]:
    """Преобразует CSV-строку в список словарей."""
    reader = csv.DictReader(StringIO(data))
    return [dict(row) for row in reader]

def compute_revenue(rows: list[dict]) -> float:
    """Вычисляет общую выручку."""
    return sum(
        int(row["quantity"]) * float(row["price"])
        for row in rows
    )

def top_item(rows: list[dict]) -> Optional[dict]:
    """Возвращает строку с максимальной выручкой."""
    if not rows:
        return None

    return max(
        rows,
        key=lambda row: int(row["quantity"]) * float(row["price"])
    )

# Пример CSV-данных
data = """date,item,quantity,price
2026-09-01,Apple,10,50
2026-09-02,Banana,5,80
2026-09-03,Orange,20,30"""

# Проверка функций
rows = parse_csv(data)

print("Распарсенные данные:")
print(rows)

print("\nОбщая выручка:")
print(compute_revenue(rows))

print("\nТовар с максимальной выручкой:")
print(top_item(rows))
